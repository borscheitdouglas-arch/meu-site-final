    /* botão Voltar estilo lateral discreto */
    .card .btn.outline { border-color:#b08a1a; color:#b08a1a; background:transparent; }

    /* reduzir tamanho do header dentro desta página para harmonizar */
    .site-header { background: transparent; }
    .site-header .logo img { height:38px; }
