<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Douglas AssumpÃ§Ã£o</title>
  <link rel="icon" href="../assets/img/edições-para-o-site/icone.png" sizes="192x192">
  <link rel="shortcut icon" href="../assets/img/edições-para-o-site/icone.png">
  <link rel="stylesheet" href="../styles/style.css">
</head>
<body>
  <header class="site-header">
    <svg width="22" height="16" viewBox="0 0 22 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="display:block"><rect y="0" width="22" height="2" rx="1" fill="currentColor"/><rect y="7" width="22" height="2" rx="1" fill="currentColor"/><rect y="14" width="22" height="2" rx="1" fill="currentColor"/></svg>
    <div class="logo"><a href="/index.html"><img src="/assets/img/icone.png" alt="CNP" id="site-logo"></a></div>
    <div class="header-actions">
      <a class="icon-btn" href="/pages/loja.html" title="Loja">
        <img src="/assets/img/icone1.png" alt="Loja" class="icon-img">
        <span class="icon-label">LOJA</span>
      </a>
      <a class="icon-btn" href="/pages/contato.html" title="Contato">
        <img src="/assets/img/icone2.png" alt="Contato" class="icon-img">
        <span class="icon-label">CONTATO</span>
      </a>
      <input id="search" type="search" placeholder="Buscar..." />
    </div>
  </header>

  <main class="container">
    <article class="list-card">
      <img src="../assets/img/edições-para-o-site/thumbnails.jpg" alt="Matéria">
      <div class="card-body">
        <small class="tag">{{TAG}}</small>
        <h1>{{TITLE}}</h1>
        <p>{{DESCRIPTION}}</p>
        <div class="card-actions">
          <a class="btn video-btn" href="{{VIDEO}}" target="_blank" rel="noopener">Ver vÃ­deo</a>
          <a class="btn outline" href="{{SHEET}}" download>Baixar partitura</a>
        </div>
      </div>
    </article>
  </main>

  <footer class="site-footer">
    <p>Â© 2025 Meu Site. Todos os direitos reservados.</p>
  </footer>

  <script src="../scripts/script.js"></script>
</body>
</html>






